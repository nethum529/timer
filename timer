# Glyphs --------------------------------------------------------------------

def arc(cx, cy, rx, ry, a0, a1, steps=48):
    """Points on an ellipse. Angles in degrees, y points down."""
    return [
        (cx + rx * math.cos(math.radians(a)), cy + ry * math.sin(math.radians(a)))
        for a in (a0 + (a1 - a0) * i / steps for i in range(steps + 1))
    ]


def _five():
    bowl = arc(3.1, 6.8, 2.9, 3.2, 222, 520)
    return [[(5.4, 0), (1.1, 0), bowl[0]] + bowl]


def _six():
    return [arc(3, 6.9, 3, 3.1, 0, 360), arc(6.2, 7, 6.2, 7, 180, 250, 24)]


def _nine():
    return [arc(3, 3.1, 3, 3.1, 0, 360), arc(-0.2, 3, 6.2, 7, 0, 70, 24)]


# Each glyph is a list of strokes in a box 6 units wide and 10 units tall.
GLYPHS = {
    "0": [arc(3, 5, 3, 5, 0, 360, 64)],
    "1": [[(1.2, 2.2), (3.6, 0), (3.6, 10)]],
    "2": [arc(3, 3, 3, 3, 180, 395) + [(0, 10), (6, 10)]],
    "3": [arc(3, 2.55, 2.6, 2.55, 195, 450), arc(3, 7.45, 3, 2.55, 270, 525)],
    "4": [[(4.6, 10), (4.6, 0), (0, 7), (6, 7)]],
    "5": _five(),
    "6": _six(),
    "7": [[(0, 0), (6, 0), (2.2, 10)]],
    "8": [arc(3, 2.45, 2.6, 2.45, 0, 360), arc(3, 7.35, 3, 2.65, 0, 360)],
    "9": _nine(),
}
DIGIT_W, COLON_W, GAP = 6.0, 1.6, 2.4
COLON_DOTS = (3.6, 8.0)


def advance(ch):
    return COLON_W if ch == ":" else DIGIT_W


def text_width(text):
    return sum(advance(c) for c in text) + GAP * (len(text) - 1)


class Canvas:
    """A pixel grid. Every terminal cell holds 2 by 4 pixels."""

    def __init__(self, cols, rows):
        self.cols, self.rows = cols, rows
        self.w, self.h = cols * 2, rows * 4
        self.px = bytearray(self.w * self.h)
        self.text = {}  # (row, col) -> (char, fg, bg)

    def put(self, x, y, color):
        if 0 <= x < self.w and 0 <= y < self.h:
            self.px[y * self.w + x] = color

    def disc(self, x, y, r, color):
        for iy in range(int(y - r - 1), int(y + r + 2)):
            for ix in range(int(x - r - 1), int(x + r + 2)):
                if (ix + 0.5 - x) ** 2 + (iy + 0.5 - y) ** 2 <= r * r:
                    self.put(ix, iy, color)

    def capsule(self, x0, y0, x1, y1, color):
        """Fill a pill shape that covers the pixel box x0..x1, y0..y1."""
        r = (y1 - y0) / 2
        cy = y0 + r
        for iy in range(y0, y1):
            for ix in range(x0, x1):
                px = min(max(ix + 0.5, x0 + r), x1 - r)
                if (ix + 0.5 - px) ** 2 + (iy + 0.5 - cy) ** 2 <= r * r:
                    self.put(ix, iy, color)

    def fill(self, x0, y0, x1, y1, color):
        for iy in range(y0, y1):
            for ix in range(x0, x1):
                self.put(ix, iy, color)

    def label(self, row, col, text, fg, bg):
        for i, ch in enumerate(text):
            self.text[(row, col + i)] = (ch, fg, bg)

    def cells(self):
        """Yield rows of (char, fg, bg) cells."""
        w, px = self.w, self.px
        for row in range(self.rows):
            out = []
            for col in range(self.cols):
                if (row, col) in self.text:
                    out.append(self.text[(row, col)])
                    continue
                base = row * 4 * w + col * 2
                pix = [px[base + dy * w + dx] for dy in range(4) for dx in range(2)]
                present = set(pix)
                present.discard(EMPTY)
                if not present:
                    out.append((" ", EMPTY, EMPTY))
                    continue
                bg = EMPTY
                if EMPTY not in pix:
                    for s in SURFACES:
                        if s in present:
                            bg = s
                            present.discard(s)
                            break
                if not present:
                    out.append((" ", EMPTY, bg))
                    continue
                fg = next(c for c in PRIORITY if c in present)
                mask = sum(1 << i for i, c in enumerate(pix) if c == fg)
                out.append((OCTANTS[mask], fg, bg))
            yield out


class GlyphCache:
    def __init__(self):
        self.cache = {}

    def pixels(self, ch, unit, weight):
        """Pixel offsets for a glyph drawn with its box at the origin."""
        key = (ch, unit, weight)
        if key not in self.cache:
            self.cache[key] = self._draw(ch, unit, weight)
        return self.cache[key]

    def _draw(self, ch, unit, weight):
        pad = int(weight) + 2
        w = int(advance(ch) * unit) + 2 * pad
        h = int(10 * unit) + 2 * pad
        c = Canvas(w // 2 + 1, h // 4 + 1)
        # Straight lines sit on the pixel grid so every stem has the
        # same width. Odd widths center on a pixel, even ones on an edge.
        off = 0.5 if weight % 2 else 0.0

        def snap(v):
            return round(v - off) + off

        if ch == ":":
            size = max(2, round(weight * 1.2))
            x = round(pad + COLON_W * unit / 2 - size / 2)
            for y in COLON_DOTS:
                y0 = round(pad + y * unit - size / 2)
                c.fill(x, y0, x + size, y0 + size, 1)
        else:
            for stroke in GLYPHS[ch]:
                pts = [[pad + x * unit, pad + y * unit] for x, y in stroke]
                if len(pts) < 6:
                    for a, b in zip(pts, pts[1:]):
                        if abs(a[0] - b[0]) < 1e-6:
                            a[0] = b[0] = snap(a[0])
                        if abs(a[1] - b[1]) < 1e-6:
                            a[1] = b[1] = snap(a[1])
                for (xa, ya), (xb, yb) in zip(pts, pts[1:]):
                    n = max(1, int(math.hypot(xb - xa, yb - ya) / 0.25))
                    for i in range(n + 1):
                        t = i / n
                        c.disc(xa + (xb - xa) * t, ya + (yb - ya) * t, weight / 2 - 0.01, 1)
        return [
            (i % c.w - pad, i // c.w - pad) for i, v in enumerate(c.px) if v
        ]


# Timer state ---------------------------------------------------------------

def parse_duration(text):
    text = text.strip().lower()
    if re.fullmatch(r"\d+", text):
        return int(text) * 60
    if re.fullmatch(r"\d+(:\d{1,2}){1,2}", text):
        total = 0
        for part in text.split(":"):
            total = total * 60 + int(part)
        return total
    m = re.fullmatch(r"(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", text)
    if m and any(m.groups()):
        h, mi, s = (int(g or 0) for g in m.groups())
        return h * 3600 + mi * 60 + s
    raise ValueError(text)


def typed_seconds(digits):
    d = digits.rjust(6, "0")
    return min(MAX_SECONDS, int(d[:2]) * 3600 + int(d[2:4]) * 60 + int(d[4:]))


def clock(seconds, hours):
    h, rest = divmod(seconds, 3600)
    m, s = divmod(rest, 60)
    if hours:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m}:{s:02d}"


class Timer:
    def __init__(self, total):
        self.total = total  # the full length, for the ring
        self.remaining = total
        self.running = False
        self.done = False
        self.end_at = 0.0
        self.typed = None  # digits while the user types a time

    def left(self):
        if not self.running:
            return self.remaining
        return max(0, math.ceil(self.end_at - time.monotonic() - 1e-6))

    def start(self):
        if self.remaining > 0:
            self.done = False
            self.running = True
            self.end_at = time.monotonic() + self.remaining

    def pause(self):
        self.remaining = self.left()
        self.running = False

    def toggle(self):
        if self.typed is not None:
            self.commit()
        elif self.done:
            self.reset()
            self.start()
        elif self.running:
            self.pause()
        elif self.remaining:
            self.start()
        else:
            self.typed = ""

    def reset(self):
        self.done = False
        self.running = False
        self.remaining = self.total

    def set(self, seconds):
        self.done = False
        self.running = False
        self.total = self.remaining = seconds

    def add(self, delta):
        """Add time, or take it away. Keeps running if it was running."""
        if self.done:
            self.set(0)
            self.done = False
        value = min(MAX_SECONDS, max(0, self.left() + delta))
        self.total = max(value, min(MAX_SECONDS, self.total + delta))
        if self.running:
            self.end_at += value - self.left()
        self.remaining = value
        if value == 0:
            self.running = False

    def type_digit(self, ch):
        if self.typed is None:
            self.typed = ""
        if len(self.typed) < MAX_TYPED and (self.typed or ch != "0"):
            self.typed += ch

    def commit(self):
        seconds = typed_seconds(self.typed or "0")
        self.typed = None
        if seconds:
            self.set(seconds)
            self.start()

    def tick(self):
        if self.running and self.left() == 0:
            self.running = False
            self.remaining = 0
            self.done = True

    def progress(self):
        """Part of the total that has passed, from 0 to 1."""
        if self.done:
            return 1.0
        if not self.total:
            return 0.0
        if self.running:
            left = max(0.0, self.end_at - time.monotonic())
        else:
            left = self.remaining
        return min(1.0, max(0.0, 1 - left / self.total))


# Drawing -------------------------------------------------------------------

class View:
    def __init__(self):
        self.glyphs = GlyphCache()
        self.ring_cache = {}
        self.regions = []  # (col0, row0, col1, row1, action)

    def ring(self, d, weight):
        """Pixels of a circle d pixels wide, with the angle from the top."""
        key = (d, weight)
        if key not in self.ring_cache:
            r = d / 2 - weight / 2
            c = d / 2
            pts = []
            for iy in range(d):
                for ix in range(d):
                    dx, dy = ix + 0.5 - c, iy + 0.5 - c
                    if abs(math.hypot(dx, dy) - r) <= weight / 2:
                        # Counterclockwise from twelve o'clock, 0 to 1.
                        a = math.atan2(-dy, dx) - math.pi / 2
                        pts.append((ix, iy, (a / (2 * math.pi)) % 1.0))
            self.ring_cache[key] = pts
        return self.ring_cache[key]

    def text(self, cv, chars, x0, y_top, unit, weight):
        """Draw (char, color) pairs. Return the pixel box of each char."""
        boxes = []
        x = x0
        for ch, color in chars:
            ox, oy = round(x), round(y_top)
            for dx, dy in self.glyphs.pixels(ch, unit, weight):
                cv.put(ox + dx, oy + dy, color)
            boxes.append((ox, ox + round(advance(ch) * unit)))
            x += (advance(ch) + GAP) * unit
        return boxes

    def display(self, t):
        """The characters to show, with colors, and the width template."""
        if t.typed is not None:
            n = 6 if len(t.typed) > 4 else 4
            digits = t.typed.rjust(n, "0")
            first = n - len(t.typed)
            chars = []
            for i, d in enumerate(digits):
                if i and i % 2 == 0:
                    chars.append((":", DIGIT if first < i else MUTED))
                chars.append((d, DIGIT if i >= first else MUTED))
            template = "00:00:00" if n == 6 else "00:00"
            return chars, template, False
        hours = max(t.total, t.left()) >= 3600
        color = ACCENT if t.done else DIGIT
        chars = [(c, color) for c in clock(t.left(), hours)]
        return chars, ("0:00:00" if hours else "00:00"), True

    def draw(self, t, cols, rows):
        cv = Canvas(cols, rows)
        self.regions = []
        chars, template, groups = self.display(t)
        full = rows >= 16 and cols >= 32

        if full:
            btn_rows = 3
            gap = max(1, rows // 16)
            margin = max(1, rows // 12)
            ring_rows = rows - 2 * margin - gap - btn_rows
            d = min(ring_rows * 4, (cols - 4) * 2)
            d -= d % 4
            block = math.ceil(d / 4) + gap + btn_rows
            top = (rows - block) // 2 * 4
            left = cols - d // 2
            cy = top + d / 2

            weight = max(2, round(d * 0.022))
            p = t.progress()
            for ix, iy, a in self.ring(d, weight):
                cv.put(left + ix, top + iy, ACCENT if a < p else TRACK)

            unit = min(d * 0.68 / text_width(template), d * 0.22 / 10)
            text_top = cy - d * 0.04 - 5 * unit
        else:
            unit = min(cols * 2 * 0.8 / text_width(template), rows * 4 * 0.6 / 10)
            text_top = rows * 2 - 5 * unit

        unit = round(unit * 4) / 4
        if unit < 1:
            self.draw_plain(cv, t, chars)
            return cv

        weight = max(1, round(unit * 0.8))
        width = text_width("".join(c for c, _ in chars)) * unit
        x0 = cols - width / 2
        boxes = self.text(cv, chars, x0, text_top, unit, weight)
        text_bottom = text_top + 10 * unit

        # Scroll targets: hours, minutes and seconds.
        row0 = int(text_top // 4) - 1
        row1 = int(text_bottom // 4) + 2
        if groups:
            spans = []
            digits = [b for (c, _), b in zip(chars, boxes) if c != ":"]
            for i in range(len(digits) - 1, -1, -2):
                a = digits[max(0, i - 1)][0]
                spans.insert(0, (a, digits[i][1]))
            units = [1, 60, 3600][: len(spans)][::-1]
            for (a, b), u in zip(spans, units):
                self.regions.append((a // 2, row0, b // 2 + 1, row1, ("time", u)))
        # The whole time, colons included, for clicks.
        self.regions.append((int(x0 // 2) - 1, row0, int((x0 + width) // 2) + 2, row1, ("time", 60)))

        if not full:
            return cv

        # Underline, the cue that the time can be typed.
        ux0, ux1 = round(cols - d * 0.3), round(cols + d * 0.3)
        uy = round(text_bottom + max(4, d * 0.07))
        cv.fill(ux0, uy, ux1, uy + 1, ACCENT if t.typed is not None else TRACK)

        # Chips that add time.
        chip_row = (uy + max(4, d * 0.06)) // 4 + 1
        chip_row = int(chip_row)
        if d >= 72 and chip_row * 4 < top + d * 0.8:
            chips = [("+0:30", 30), ("+1:00", 60)]
            widths = [len(c) + 4 for c, _ in chips]
            col = cols // 2 - (sum(widths) + 2) // 2
            for (label, secs), w in zip(chips, widths):
                cv.capsule(col * 2, chip_row * 4, (col + w) * 2, chip_row * 4 + 4, CHIP)
                cv.label(chip_row, col + 2, label, CHIP_TEXT, CHIP)
                self.regions.append((col, chip_row, col + w, chip_row + 1, ("add", secs)))
                col += w + 2

        # Play and reset.
        brow = (top + d) // 4 + gap
        bw = d // 2 // 2 - 1  # columns per button
        lcol = cols // 2 - 1 - bw
        rcol = cols // 2 + 1
        y0, y1 = brow * 4, (brow + btn_rows) * 4
        for col, action in ((lcol, "toggle"), (rcol, "reset")):
            cv.capsule(col * 2, y0, (col + bw) * 2, y1, BUTTON)
            self.regions.append((col, brow, col + bw, brow + btn_rows, (action, 0)))
        playing = t.running and t.typed is None
        mid = brow + btn_rows // 2
        cv.label(mid, lcol + bw // 2, PAUSE if playing else PLAY, ICON, BUTTON)
        cv.label(mid, rcol + bw // 2, RESET, ICON, BUTTON)
        return cv

    def draw_plain(self, cv, t, chars):
        text = "".join(c for c, _ in chars)
        row, col = cv.rows // 2, max(0, (cv.cols - len(text)) // 2)
        for i, (c, color) in enumerate(chars[: cv.cols]):
            cv.label(row, col + i, c, color, EMPTY)
        self.regions.append((col, row, col + len(text), row + 1, ("time", 60)))

    def hit(self, col, row):
        for c0, r0, c1, r1, action in self.regions:
            if c0 <= col < c1 and r0 <= row < r1:
                return action
        return None


# Terminal ------------------------------------------------------------------

class Screen:
    def __init__(self, scr):
        self.scr = scr
        self.pairs = {}
        self.palette = XTERM if curses.COLORS >= 256 else BASIC

    def attr(self, fg, bg):
        key = (fg, bg)
        if key not in self.pairs:
            n = len(self.pairs) + 1
            curses.init_pair(n, self.palette.get(fg, -1), self.palette.get(bg, -1))
            self.pairs[key] = curses.color_pair(n)
        return self.pairs[key]

    def paint(self, cv):
        scr = self.scr
        scr.erase()
        for row, cells in enumerate(cv.cells()):
            col = 0
            while col < len(cells):
                _, fg, bg = cells[col]
                end = col
                while end < len(cells) and cells[end][1:] == (fg, bg):
                    end += 1
                run = "".join(c for c, _, _ in cells[col:end])
                if run.strip() or bg != EMPTY:
                    try:
                        scr.addstr(row, col, run, self.attr(fg, bg))
                    except curses.error:
                        pass  # the last cell of the screen raises
                col = end
        scr.refresh()


def run(scr, t):
    curses.curs_set(0)
    curses.use_default_colors()
    curses.mousemask(curses.ALL_MOUSE_EVENTS)
    curses.mouseinterval(0)
    screen = Screen(scr)
    view = View()
    scroll_up = getattr(curses, "BUTTON4_PRESSED", 0)
    scroll_down = getattr(curses, "BUTTON5_PRESSED", 0x200000)

    while True:
        t.tick()
        rows, cols = scr.getmaxyx()
        screen.paint(view.draw(t, cols, rows))

        if t.running:
            wait = (t.end_at - time.monotonic()) % 1.0 or 1.0
            scr.timeout(max(1, int(wait * 1000) + 5))
        else:
            scr.timeout(-1)

        key = scr.getch()
        if key == -1 or key == curses.KEY_RESIZE:
            continue
        if key == curses.KEY_MOUSE:
            try:
                _, mx, my, _, b = curses.getmouse()
            except curses.error:
                continue
            action = view.hit(mx, my)
            if b & (scroll_up | scroll_down):
                unit = action[1] if action and action[0] == "time" else 60
                t.typed = None
                t.add(unit if b & scroll_up else -unit)
            elif b & curses.BUTTON1_PRESSED and action:
                kind, value = action
                if kind == "toggle":
                    t.toggle()
                elif kind == "reset":
                    t.typed = None
                    t.reset()
                elif kind == "add":
                    t.typed = None
                    t.add(value)
                    if not t.running:
                        t.start()
                elif kind == "time":
                    t.typed = "" if t.typed is None else None
            continue

        ch = chr(key) if 0 <= key < 256 else ""
        if ch.isdigit():
            t.type_digit(ch)
        elif key in (curses.KEY_BACKSPACE, 127, 8) and t.typed is not None:
            t.typed = t.typed[:-1]
        elif ch in ("\n", "\r", " ") or key == curses.KEY_ENTER:
            t.toggle()
        elif key == 27:
            if t.typed is None:
                return
            t.typed = None
        elif ch in ("q", "Q"):
            return
        elif t.done:
            t.reset()
        elif ch in ("r", "R"):
            t.typed = None
            t.reset()
        elif key in (curses.KEY_UP, ord("+"), ord("="), ord("k")):
            t.typed = None
            t.add(60)
        elif key in (curses.KEY_DOWN, ord("-"), ord("_"), ord("j")):
            t.typed = None
            t.add(-60)


def cli():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    total = 0
    if args:
        try:
            total = min(MAX_SECONDS, parse_duration("".join(args)))
        except ValueError:
            print(f"timer: cannot read duration '{' '.join(args)}'", file=sys.stderr)
            return 2
    t = Timer(total)
    if total:
        t.start()
    else:
        t.typed = ""
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(run, t)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(cli())
