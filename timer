         ICON: 230, CHIP: 237, CHIP_TEXT: 250}
BASIC = {DIGIT: -1, MUTED: 8, TRACK: 8, ACCENT: 3, BUTTON: 3,
         ICON: 0, CHIP: 8, CHIP_TEXT: 7}
SURFACES = (BUTTON, CHIP)
PLAY, PAUSE, RESET = "\u25b6", "\u275a\u275a", "\u21ba"
PRIORITY = (ACCENT, DIGIT, MUTED, ICON, CHIP_TEXT, TRACK, BUTTON, CHIP)

