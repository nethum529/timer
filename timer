#!/usr/bin/env python3
"""timer: a minimal terminal countdown.

usage: timer [DURATION]

  DURATION  5, 5m, 90s, 1h30m, 1:30, 1:00:00  (a plain number is minutes)

Type digits to set a time, then press enter. Click the time to edit it,
scroll on it to change it, and use the buttons with the mouse.

keys  0-9 type a time, enter or space start or pause, backspace delete,
      r reset, up and down change minutes, esc cancel, q quit
"""

import curses
import math
import os
import re
import sys
import time

MAX_SECONDS = 100 * 3600 - 1
MAX_TYPED = 6

# Colors. The number is an xterm 256 color, -1 is the terminal default.
EMPTY, DIGIT, MUTED, TRACK, ACCENT, BUTTON, ICON, CHIP, CHIP_TEXT = range(9)
